# Paystack public key (pk_test_... for testing, pk_live_... for real payments).
# Never put the secret key (sk_...) here.
VITE_PAYSTACK_PUBLIC_KEY=

# Admin area (/admin). Set these in Vercel > Settings > Environment Variables.
ADMIN_PASSWORD=
# Any long random string; signs the admin login session.
ADMIN_SECRET=
# Added automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
